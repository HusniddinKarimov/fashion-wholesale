# ── Database (PostgreSQL) ───────────────────────────────────────────────────────
# Local dev: start one with `docker compose -f docker/docker-compose.yml up -d db`
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fashionwholesale"
# Production (RDS) — TLS required:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fashionwholesale?sslmode=require"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ── Docker / Production ───────────────────────────────────────────────────────
POSTGRES_PASSWORD="your-secure-db-password"
